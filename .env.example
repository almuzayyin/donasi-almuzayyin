# =================================================================
# Admin Panel
# =================================================================
# Comma-separated email yang boleh akses /admin
ADMIN_EMAILS=admin@al-muzayyin.org

# =================================================================
# Konfigurasi Aplikasi
# =================================================================
# Harga satuan mushaf (IDR) - DEPRECATED
# Sekarang diatur via /admin/settings (DB-backed). Env var ini diabaikan.
# Tetap ada untuk backward compat, akan dihapus di versi depan.
MUSHAF_UNIT_PRICE=85000

# =================================================================
# Midtrans Payment Gateway
# =================================================================
# Daftar di https://dashboard.sandbox.midtrans.com -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXXXXXXXXXX
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXXXXXXXXXX
MIDTRANS_IS_PRODUCTION=false

# Callback URLs
PAYMENT_FINISH_URL=http://localhost:3000/sukses
PAYMENT_ERROR_URL=http://localhost:3000/gagal
# Untuk webhook lokal pakai ngrok:
# PAYMENT_NOTIFICATION_URL=https://abc123.ngrok.io/api/midtrans/webhook
PAYMENT_NOTIFICATION_URL=

# =================================================================
# Email Sending (Resend) — production
# =================================================================
# Daftar gratis di https://resend.com (3.000 email/bulan free)
# 1. Verify domain `yayasanislamalmuzayin.com` di Resend dashboard
# 2. Tambah DNS records (SPF/DKIM) di Cloudflare
# 3. Generate API Key → paste di sini
# Tanpa key ini, email log ke console saja (mode dev)
RESEND_API_KEY=

# Sender email — harus dari domain yang sudah diverify di Resend
# Contoh: "Yayasan Al Muzayyin <donasi@yayasanislamalmuzayin.com>"
EMAIL_FROM=

# Fallback admin notification email kalau setting DB belum di-set
NOTIFICATION_EMAIL=

# Site URL untuk link di email notification
NEXT_PUBLIC_SITE_URL=https://yayasanislamalmuzayin.com
